import os
from pathlib import Path

# Thử load .env nếu python-dotenv khả dụng
try:
    from dotenv import load_dotenv
    base_dir = Path(__file__).resolve().parent.parent.parent
    env_site = base_dir / 'environment' / 'site.env'
    if env_site.exists():
        load_dotenv(env_site)
except ImportError:
    pass

